<Window x:Class="BholaCattleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BholaCattleApp"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" 
        Title="Cattle Managemenat System" Height="700" Width="950">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"  HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderThickness="1.5" Margin="10" BorderBrush="Black" Height="25" VerticalAlignment="Center" Effect="{StaticResource DropShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="fd_search" Width="180"  Height="20"  Margin="5 0 20 0" VerticalContentAlignment="Center"  BorderThickness="0" Tag="Search..."/>
                    <materialDesign:PackIcon Kind="Magnify" Grid.Column="1" Width="22" Height="22" VerticalAlignment="Center"  Margin="0 0 4 0" Foreground="Black"/>
                </Grid>
            </Border>
            
            <TextBlock Grid.Column="1" Text="{Binding FullName}" Effect="{StaticResource DropShadowEffect}" VerticalAlignment="Center" Margin="20 2 300 0" FontWeight="DemiBold" FontSize="16" FontFamily="Myriad Pro"/>

            <Button x:Name="btn_setting" Grid.Column="3" Cursor="Hand" Style="{StaticResource setbutton}" Margin="-46 2 0 2" />
            <TextBlock Grid.Column="3" Text="Settings" Effect="{StaticResource DropShadowEffect}" Foreground="Black" Margin="-15,17,100,15" HorizontalAlignment="Left" Width="auto" FontWeight="Medium" FontSize="14" FontFamily="Myriad Pro" Cursor="Hand"/>

            <Button x:Name="btn_logout" Grid.Column="3" Cursor="Hand" Style="{StaticResource logoutbutton}" Margin="53 2 15 2" />
            <TextBlock Grid.Column="3" Text="Log Out" Effect="{StaticResource DropShadowEffect}" Foreground="Black" Margin="85,17,20,15" HorizontalAlignment="Left" Width="auto" FontWeight="Medium" FontSize="14" FontFamily="Myriad Pro" Cursor="Hand"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Button Content="Home" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToHomeCommand}" Margin="8 10 0 0"/>

                <Button Content="Animal Records" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToAnimalRecordsCommand}" Margin="8 10 0 0" />

                <Button Content="Status of Animal" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToStatusAnimalRecordsCommand}" Margin="8 10 0 0"/>

                <Button Content="Heifer" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToHeiferRecordsCommand}" Margin="8 10 0 0"/>

                <Button Content="Pregnant" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToPregnantAnimalRecordsCommand}" Margin="8 10 0 0"/>

                <Button Content="Milking" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToMilkingAnimalRecordsCommand}" Margin="8 10 0 0"/>

                <Button Content="Feed" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToFeedingRecordsCommad}" Margin="8 10 0 0"/>

                <Button Content="Medicine" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToMedicineRecordsCommad}" Margin="8 10 0 0"/>

                <Button Content="Vaccine" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToVaccineRecordsCommad}" Margin="8 10 0 0"/>

                <Button Content="Transaction" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateToTransactionRecordsCommad}" Margin="8 10 0 0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#f8f8f8" Margin="10" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="10" Effect="{StaticResource DropShadowEffect}">
                <ContentControl Content="{Binding CurrentView}" />
            </Border>
        </Grid>
    </Grid>
</Window>
