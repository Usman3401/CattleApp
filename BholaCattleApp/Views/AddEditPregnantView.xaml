<UserControl x:Class="BholaCattleApp.Views.AddEditPregnantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BholaCattleApp.Views"
             mc:Ignorable="d" 
             d:DesignWidth="800" Height="580">
    <Grid Margin="0,0,0,75" >
        <StackPanel Height="505" VerticalAlignment="Top">
            <TextBlock Text="{Binding Title}" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Animal ID:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding AnimalID}" Margin="0,0,0,10"/>
            <TextBlock Text="Status ID:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding StatusID}" Margin="0,0,0,10"/>
            <TextBlock Text="Pregnant Date:" Margin="0,0,0,5"/>
            <DatePicker SelectedDate="{Binding PregnantDate}" Margin="0,0,0,10"/>
            <TextBlock Text="Deliver Date:" Margin="0,0,0,5"/>
            <DatePicker SelectedDate="{Binding DeliverDate}" Margin="0,0,0,10"/>
            <TextBlock Text="Gender:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Gender}" Margin="0,0,0,10" />
            <TextBlock Text="Result:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Result}" Margin="0,0,0,10" />
            <TextBlock Text="Notes:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Notes}" Margin="0,0,0,20" Height="50" AcceptsReturn="True"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Margin="0,0,10,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
