<UserControl x:Class="BholaCattleApp.Views.MilkingAnimalRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BholaCattleApp.Views"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Milking Animals" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button Content="Add" Command="{Binding AddMilkingCommand}" Width="80" Margin="5"/>
                <Button Content="Edit" Command="{Binding EditMilkingCommand}" Width="80" Margin="5"/>
                <Button Content="Delete" Command="{Binding DeleteMilkingCommand}" Width="80" Margin="5"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Milkings}" SelectedItem="{Binding SelectedMilking}" AutoGenerateColumns="False" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding MilkingHistoryID}" Width="50"/>
                    <DataGridTextColumn Header="Animal ID" Binding="{Binding AnimalID}" Width="*"/>
                    <DataGridTextColumn Header="Status ID" Binding="{Binding StatusID}" Width="*"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding MilkingDate, StringFormat=dd/MM/yyyy}" Width="*"/>
                    <DataGridTextColumn Header="Morning Qty" Binding="{Binding MorningQty}" Width="*"/>
                    <DataGridTextColumn Header="Evening Qty" Binding="{Binding EveningQty}" Width="*"/>
                    <DataGridTextColumn Header="Night Qty" Binding="{Binding NightQty}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
